    "csls_beta": 0.3,
    "bridge_max_per_target": 2
  },
  "six_degree_decay": {
    "gamma": 0.75,
    "epsilon": 0.15,
    "edge_w_base": 0.5,
    "edge_w_cos_offset": 0.5,
    "edge_w_cos_threshold": 0.2
  },
  "three_layer_weight": {
    "analogy": 1.3,
    "skeleton_cross": 1.2,
    "t45_bridge_step6": 1.1,
