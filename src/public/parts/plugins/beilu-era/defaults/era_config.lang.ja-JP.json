{
	"_说明": "beilu-era 日本語 语言差量层（叠加在默认模板上：文案替换为日文，terrain/placement 键为增补——中日键共存）",

	"terrain": {
		"presets": {
			"森": { "chars": "森林木", "color": "#3f7a3f" },
			"畑": { "chars": "+", "color": "#7a8a3f" },
			"川": { "chars": "∞~", "color": "#3f6a8a" },
			"竹林": { "chars": "竹林", "color": "#4f8a4f" }
		}
	},

	"placement": {
		"center": { "anchor": "center", "desc": "部屋の中央" },
		"door": { "anchor": "door", "desc": "扉の内側" },
		"corner": { "anchor": "topleft", "dx": 1, "dy": 1, "desc": "内側左上の隅" },
		"north": { "anchor": "wall_n", "desc": "北壁の内側中点" },
		"south": { "anchor": "wall_s", "desc": "南壁の内側中点" },
		"east": { "anchor": "wall_e", "desc": "東壁の内側中点" },
		"west": { "anchor": "wall_w", "desc": "西壁の内側中点" },
		"near": { "anchor": "near", "desc": "エンティティの隣（near:id 指定）" }
	},

	"compass": { "n": "北", "s": "南", "e": "東", "w": "西" },

	"textLabels": {
		"headerLine": "{name} (id:{id} rev{rev})",
		"floorHeader": "── {f}階 ──",
		"truncatedLine": "省略された部屋: ",
		"stairsLine": "階段: ",
		"entsLine": "キャラ: ",
		"compassLine": "方位: 上{n} 下{s} 左{w} 右{e}"
	}
}
