{
  "id": "chat",
  "label": "闲聊",
  "icon": "💬",
  "desc": "airp 基座：P1 自驱动主场 + 联网 + 跨窗调度（底部功能层：chat 有联网+调动其他窗口）",
  "base": null,
  "injectionScopes": [
    "chat",
    "airp"
  ],
  "_note": "T5 首版铁则：features 照抄现状真值（散点清单 2026-07-02），config=声明表（差异行为仍由功能层内 if 驱动，切流量批逐项接线）。hooks 序=现状插件链序，影子 diff 是序的最终裁判。injectionScopes（inj 识别系统 2026-07-13）：chat 模式接收 autoMode=chat/airp 两域——airp 是别名域（AIRP tab→mode='chat'，modeTabMap TAB_TO_MODE.airp 同语义），历史 autoMode='airp' 条目由此生效。",
  "features": {
    "memory": {
      "enabled": true,
      "config": {
        "hotLayerDir": null,
        "orphanStrip": false,
        "codeProjectEnv": false
      }
    },
    "teaching": {
      "enabled": true,
      "config": {
        "taskPlanHowto": false,
        "dailyGreeting": true
      }
    },
    "p1": {
      "enabled": true,
      "config": {
        "selfDriven": true,
        "aiP1": true,
        "_note_selfDriven": "[0729 002拍板插件化解封] chat模式先行灰度开启selfDriven。内存由beilu-p1-selfdriven插件生命周期管理(Load零资源+idle自动卸载+Unload清缓存),经p1Bridge.mjs桥调用(照vectorBridge范式),禁绕门直接import p1_pipeline(0724内存案教训不变)。双门:selfDriven=mode级路由;插件enabled=用户级开关(默认false,需用户在面板手动开启)。selfDriven成功则跳过aiP1;失败/插件未启用→aiP1降级(零回归)。其余模式(code/work/bot/smart)仍false,待chat验证后另批。"
      }
    },
    "websearch": {
      "enabled": true
    },
    "scheduler": {
      "enabled": true,
      "config": {
        "dueJobsInject": false,
        "crossWindowWake": true
      }
    },
    "flowGroup": {
      "enabled": false
    },
    "ide": {
      "enabled": false
    },
    "taskRunner": {
      "enabled": false
    },
    "preset": {
      "enabled": true,
      "config": {
        "strategy": "single"
      }
    }
  },
  "hooks": {
    "request": [
      {
        "target": "functions:memory",
        "verb": "getPrompt",
        "feature": "memory",
        "slot": "beilu-memory"
      },
      {
        "target": "functions:prompt",
        "verb": "mvuGetPrompt",
        "slot": "beilu-mvu"
      },
      {
        "target": "functions:prompt",
        "verb": "toggleGetPrompt",
        "slot": "beilu-toggle"
      },
      {
        "target": "functions:prompt",
        "verb": "sysinfoGetPrompt",
        "slot": "beilu-sysinfo"
      },
      {
        "target": "functions:prompt",
        "verb": "worldInfo",
        "slot": "beilu-worldbook"
      },
      {
        "target": "functions:prompt",
        "verb": "getPrompt",
        "feature": "preset",
        "slot": "beilu-preset"
      },
      {
        "phase": "tweak",
        "dl": [
          2,
          1,
          0
        ],
        "steps": [
          {
            "target": "functions:prompt",
            "verb": "mvuTweakPrompt",
            "slot": "beilu-mvu"
          },
          {
            "target": "functions:prompt",
            "verb": "wbTweakPrompt",
            "slot": "beilu-worldbook"
          },
          {
            "target": "functions:prompt",
            "verb": "tweakPrompt",
            "feature": "preset",
            "slot": "beilu-preset"
          }
        ]
      }
    ]
  },
  "presetBinding": {
    "strategy": "single",
    "submodeSet": null,
    "resolvePreset": "active_preset_map[chatId]"
  },
  "cache": {
    "scopeKeys": [
      "mode",
      "chatId"
    ]
  },
  "storage": {
    "root": "getModeCtxDir"
  },
  "_note2": "菜单完整性(步骤4普查): GetPrompt相插件参与者=memory/preset/worldbook/mvu/toggle/sysinfo(经facade)+files/browser/plugin-host(未迁无facade,影子孪生直调不进ModeDef); 相内并发各写各槽=序不影响产物,等价约束只在相位边界"
}
