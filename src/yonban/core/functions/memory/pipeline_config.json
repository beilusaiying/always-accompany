      "Causes": 0.9,
      "HasProperty": 0.8,
      "MotivatedByGoal": 0.85,
      "CapableOf": 0.7,
      "IsA": 0.6,
      "UsedFor": 0.65,
      "HasSubevent": 0.55,
      "RelatedTo": 0.1,
      "Synonym": 0.05
    }
  },
  "info_gap": {
    "boost": 1.3
  },
