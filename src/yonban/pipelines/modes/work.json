{
  "id": "work",
  "label": "工作",
  "icon": "📋",
  "desc": "11 work 子模式流程组 + 定时调度主场（DEFAULT_WORK_SUB_MODES + flowGroup auto_advance）",
  "base": "chat",
  "_note": "照抄现状真值：dueJobsInject=:1174 到期任务注入；flowGroup.stateInject=:1627 W58；hotLayerStyle=framework-first 即 :404 『_开头全文/普通只摘要』。work 无 taskRunner（用 flowGroup auto_advance，设计① §3.3）。",
  "features": {
    "memory": {
      "enabled": true,
      "config": {
        "hotLayerDir": "work/active",
        "hotLayerStyle": "framework-first",
        "orphanStrip": true,
        "codeProjectEnv": false
      }
    },
    "teaching": {
      "enabled": true,
      "config": {
        "taskPlanHowto": true,
        "dailyGreeting": false
      }
    },
    "p1": {
      "enabled": true,
      "config": {
        "selfDriven": true,
        "aiP1": true,
        "_note_selfDriven": "[0730 002拍板投入使用] chat/code/work三模式开启selfDriven。内存由beilu-p1-selfdriven插件生命周期管理。work词库AT_work 2436词+CN倒排+CFN框架62K词。双门:selfDriven=mode级路由;插件enabled=用户级开关。"
      }
    },
    "websearch": {
      "enabled": true
    },
    "scheduler": {
      "enabled": true,
      "config": {
        "dueJobsInject": true,
        "crossWindowWake": true
      }
    },
    "flowGroup": {
      "enabled": true,
      "config": {
        "stateInject": true
      }
    },
    "ide": {
      "enabled": false
    },
    "taskRunner": {
      "enabled": false
    },
    "preset": {
      "enabled": true,
      "config": {
        "strategy": "submode-chain",
        "submodeSet": "DEFAULT_WORK_SUB_MODES"
      }
    }
  },
  "hooks": {
    "request": [
      {
        "target": "functions:memory",
        "verb": "getPrompt",
        "feature": "memory",
        "slot": "beilu-memory"
      },
      {
        "target": "functions:prompt",
        "verb": "mvuGetPrompt",
        "slot": "beilu-mvu"
      },
      {
        "target": "functions:prompt",
        "verb": "toggleGetPrompt",
        "slot": "beilu-toggle"
      },
      {
        "target": "functions:prompt",
        "verb": "sysinfoGetPrompt",
        "slot": "beilu-sysinfo"
      },
      {
        "target": "functions:prompt",
        "verb": "worldInfo",
        "slot": "beilu-worldbook"
      },
      {
        "target": "functions:prompt",
        "verb": "getPrompt",
        "feature": "preset",
        "slot": "beilu-preset"
      },
      {
        "phase": "tweak",
        "dl": [
          2,
          1,
          0
        ],
        "steps": [
          {
            "target": "functions:prompt",
            "verb": "mvuTweakPrompt",
            "slot": "beilu-mvu"
          },
          {
            "target": "functions:prompt",
            "verb": "wbTweakPrompt",
            "slot": "beilu-worldbook"
          },
          {
            "target": "functions:prompt",
            "verb": "tweakPrompt",
            "feature": "preset",
            "slot": "beilu-preset"
          }
        ]
      }
    ]
  },
  "presetBinding": {
    "strategy": "submode-chain",
    "submodeSet": "DEFAULT_WORK_SUB_MODES",
    "resolvePreset": "active_preset_map[chatId]"
  },
  "cache": {
    "scopeKeys": [
      "mode",
      "chatId"
    ]
  },
  "storage": {
    "root": "getModeCtxDir"
  },
  "_note2": "菜单完整性(步骤4普查): GetPrompt相插件参与者=memory/preset/worldbook/mvu/toggle/sysinfo(经facade)+files/browser/plugin-host(未迁无facade,影子孪生直调不进ModeDef); 相内并发各写各槽=序不影响产物,等价约束只在相位边界"
}
