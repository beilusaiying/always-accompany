    "quota_tight": 2,
    "quota_mid": 3,
    "quota_loose": 4
  },
  "mmr": {
    "lambda": 0.7
  },
  "novelty": {
    "waste_cos_threshold": 0.7,
    "waste_penalty": 0.5,
    "sweet_min": 0.3,
    "sweet_max": 0.7,
    "sweet_bonus_scale": 0.5,
    "distant_penalty": 0.3
